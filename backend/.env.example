GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Optional organization ID allowed to use environment GitHub credentials.
# If omitted, environment credentials apply only to the legacy MeetFlow Demo workspace.
GITHUB_ENV_ORGANIZATION_ID=
# Optional persistent SQLite file (parent directory must already exist)
DATABASE_PATH=
# Optional extra browser origins for development, comma separated
ALLOWED_ORIGINS=http://localhost:5173
# Set a strong random secret for hosted deployments; otherwise a local secret file is generated.
SESSION_SECRET=
# Set true when serving over HTTPS.
COOKIE_SECURE=false
# Optional registry and organization database locations. Back up all of them together.
ORGANIZATION_DATA_DIR=
AUTH_DATABASE_PATH=
